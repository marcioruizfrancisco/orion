# ============================================================
# Orion Project
#
# Arquivo:
#   .env.example
#
# Objetivo:
#   Modelo de configuração das variáveis de ambiente Orion.
#
# Observação:
#   Este arquivo deve ser copiado para:
#
#   .env
#
# Antes da execução das Stacks Docker.
#
# O arquivo .env contém valores específicos da instalação
# e não deve ser enviado ao Git.
#
# ============================================================

# SÓ PARA VER SE APAGA MESMO DE novo

# ============================================================
# Projeto
# ============================================================

ORION_PROJECT_NAME=orion

# Caminho raiz do Orion
ORION_ROOT=/srv/base/orion

#Caminho onde irão ficar os bancos de dados 
ORION_STORAGE=${ORION_ROOT}/storage


############################################################
# Domínio base (muda por ambiente)
############################################################

# Local:
ORION_DOMAIN=localhost

# Servidor:
# ORION_DOMAIN=chiko.com.br

# Timezone usado por stacks que precisam de hora local correta
# (Uptime Kuma, e outras que vierem a seguir).
ORION_TZ=America/Sao_Paulo

############################################################



# ==========================================================
# DockerBase - PostgreSQL
# ==========================================================

POSTGRES_HOSTNAME=orion-postgres


POSTGRES_DB=orion
POSTGRES_USER=orion
POSTGRES_PASSWORD=orion123

# ==========================================================
# DockerBase - Redis
# ==========================================================


REDIS_HOSTNAME=orion-redis


############################################################
# ORION - Evolution API
# Arquivo: .env.example
#
# Este arquivo é o modelo de configuração do Orion.
# O arquivo .env real deve ser criado a partir deste modelo.
############################################################


############################################################
# INFRAESTRUTURA COMPARTILHADA
############################################################

ORION_NETWORK=orion-network

DATABASE_HOST=orion-postgres
DATABASE_PORT=5432

REDIS_HOST=orion-redis



############################################################
# CONTAINER NAME
############################################################

POSTGRES_CONTAINER_NAME=orion-postgres
REDIS_CONTAINER_NAME=orion-redis
EVOLUTION_CONTAINER_NAME=orion-evolution
EXAMPLE_CONTAINER_NAME=orion-example
TRAEFIK_CONTAINER_NAME=orion-traefik
PGADMIN_CONTAINER_NAME=orion-pgadmin
UPTIMEKUMA_CONTAINER_NAME=orion-uptime-kuma
EVOAUTH_CONTAINER_NAME=orion-evo-auth
EVOCRM_CONTAINER_NAME=orion-evocrm
EVOCRM_WORKER_CONTAINER_NAME=orion-evocrm-worker



############################################################
# IMAGEM
############################################################

POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:8
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EXAMPLE_IMAGE=nginx:latest
TRAEFIK_IMAGE=traefik:v3.1
PGADMIN_IMAGE=dpage/pgadmin4:9.16
UPTIMEKUMA_IMAGE=louislam/uptime-kuma:2.4.0
EVOAUTH_IMAGE=evoapicloud/evo-auth-service-community:1.0.0-rc7
EVOCRM_IMAGE=evoapicloud/evo-ai-crm-community:1.0.0-rc7


############################################################
# PORTAS
#
# Antes de adicionar uma nova Stack, verificar conflitos.
############################################################

POSTGRES_PORT=5432
REDIS_PORT=6379
EVOLUTION_PORT=9080
EXAMPLE_PORT=7080
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
PGADMIN_PORT=5050
UPTIMEKUMA_PORT=3001
EVOAUTH_PORT=3010
EVOCRM_PORT=3011


############################################################
# VOLUMES
############################################################

POSTGRES_DATA_PATH=${ORION_STORAGE}/postgres
REDIS_DATA_PATH=${ORION_STORAGE}/redis
EVOLUTION_DATA_PATH=${ORION_STORAGE}/evolution-api
EXAMPLE_WEB_PATH=/srv/base/orion/www/example
TRAEFIK_DATA_PATH=${ORION_STORAGE}/traefik
PGADMIN_DATA_PATH=${ORION_STORAGE}/pgadmin
UPTIMEKUMA_DATA_PATH=${ORION_STORAGE}/uptime-kuma
EVOAUTH_STORAGE_PATH=${ORION_STORAGE}/evo-auth
EVOCRM_STORAGE_PATH=${ORION_STORAGE}/evocrm


############################################################
# Adicionar dentro do bloco "Projeto", junto de ORION_ROOT
############################################################

# Domínio base do ambiente. Muda por máquina:
#   Local:     ORION_DOMAIN=localhost
#   Servidor:  ORION_DOMAIN=chiko.com.br
ORION_DOMAIN=localhost


############################################################
# HOSTNAMES (Traefik) — cada stack referencia ${ORION_DOMAIN}
############################################################

TRAEFIK_DASHBOARD_HOSTNAME=traefik.${ORION_DOMAIN}
EVOLUTION_HOSTNAME=evolution.${ORION_DOMAIN}
PGADMIN_HOSTNAME=pgadmin.${ORION_DOMAIN}
UPTIMEKUMA_HOSTNAME=uptime-kuma.${ORION_DOMAIN}
EVOAUTH_HOSTNAME=evo-auth.${ORION_DOMAIN}
EVOCRM_HOSTNAME=evo-crm.${ORION_DOMAIN}


# Hostname do frontend (evo-ai-frontend-community) — ainda não
# montamos essa stack, mas a variável já é referenciada pelo
# auth-service e pelo CRM pra CORS/redirects.
EVOCRM_FRONTEND_HOSTNAME=evo-app.${ORION_DOMAIN}


# N8N_HOSTNAME=n8n.${ORION_DOMAIN}
# MINIO_HOSTNAME=minio.${ORION_DOMAIN}
# MINIO_CONSOLE_HOSTNAME=minio-console.${ORION_DOMAIN}
# CHATWOOT_HOSTNAME=chatwoot.${ORION_DOMAIN}
# MAUTIC_HOSTNAME=mautic.${ORION_DOMAIN}
# CAL_HOSTNAME=cal.${ORION_DOMAIN}
# ... e assim por diante conforme cada stack for sendo montada
 
############################################################
# ORION - SENHAS, password
############################################################

# --- SEGREDO DO RAILS (gerar com: openssl rand -hex 64) ---
EVOAUTH_SECRET_KEY_BASE=troque-por-um-valor-gerado

# --- SEGREDO DO RAILS ---
EVOCRM_SECRET_KEY_BASE=troque-por-um-valor-gerado


############################################################
# BANCO DE DADOS - EVOLUTION
#
# Cada Stack possui seu próprio banco e usuário.
############################################################

EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution123

# --- BANCO DE DADOS ---
EVOAUTH_DB_NAME=evo_auth
EVOAUTH_DB_USER=evo_auth
EVOAUTH_DB_PASSWORD=troque-esta-senha

# --- BANCO DE DADOS ---
EVOCRM_DB_NAME=evo_crm
EVOCRM_DB_USER=evo_crm
EVOCRM_DB_PASSWORD=troque-esta-senha




############################################################
# REDIS - EVOLUTION
#
# Redis é compartilhado pela DockerBase.
############################################################

EVOLUTION_REDIS_DB=1

# --- REDIS (índice lógico próprio, não repetir de outra stack) ---
EVOAUTH_REDIS_DB=2
EVOCRM_REDIS_DB=3



############################################################
# CONFIGURAÇÕES ESPECÍFICAS EVOLUTION API
############################################################

EVOLUTION_API_KEY=evolution123
EVOLUTION_AUTHENTICATION_API_KEY=evolution123

EVOLUTION_DATABASE_PROVIDER=postgresql
EVOLUTION_DATABASE_CONNECTION_URI=postgresql://${EVOLUTION_DB_USER}:${EVOLUTION_DB_PASSWORD}@${POSTGRES_HOSTNAME}:5432/${EVOLUTION_DB_NAME}

############################################################
# CONFIGURAÇÕES ESPECÍFICAS PGADMIN
############################################################

# Login de acesso ao pgAdmin (não é usuário do Postgres,
# é só o login da própria interface web do pgAdmin)
PGADMIN_DEFAULT_EMAIL=admin@chiko.com.br
PGADMIN_DEFAULT_PASSWORD=troque-esta-senha

############################################################
# CONFIGURAÇÕES GERAIS
############################################################

EVOLUTION_LOG_LEVEL=ERROR
EVOLUTION_LANGUAGE=pt-BR


############################################################
# CONFIGURAÇÕES ESPECÍFICAS TRAEFIK
############################################################

# E-mail usado pelo Let's Encrypt para avisos de expiração de certificado
TRAEFIK_ACME_EMAIL=seu-email@dominio.com

# Nível de log: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO

# Dashboard do Traefik (rotas/serviços). Deixar "false" até configurar
# autenticação básica no label do dashboard.
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_DASHBOARD_HOSTNAME=traefik.seudominio.com



############################################################
# OPCIONAIS
#
# Ativar somente se necessário.
############################################################

# RABBITMQ_ENABLED=false

# S3_ENABLED=false

# MINIO_ENABLED=false


